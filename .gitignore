# Licensed data — NEVER commit (FISD + TRACE, incl. holdout). Covers the repo-root
# /data/ tree only (development, fisd, holdout). Root-anchored so it does NOT catch
# code-adjacent config under agents/**/data/ (registries, prompts, transform tables).
# The licensed-data ban itself is enforced by scripts/check_no_licensed_data.sh
# (root-anchored ^data/… over parquet/csv/fisd), not by this ignore.
# See docs/data_governance.md.
/data/

# Copyrighted source papers (publisher PDFs) — same class as /data/: held locally,
# never committed. The parser bake-off consumes these; they are not redistributable.
/papers/

# Regenerable full-text canonical dumps (parser bake-off output). Rebuild from
# /papers/ via scripts/parser_bakeoff; the freeze RECIPE lives in the committed
# config/canonical_text.yaml, so nothing here needs to be in history. (Quote
# fixtures under evaluation/quote_fixtures/ ARE committed — small excerpts.)
/evaluation/canonical_texts/

# T5 adversarial perturbed frozen texts — regenerable by evaluation/harness/perturb.py from the
# committed golds + clean frozen texts + perturbation_prereg.md + deletion_valid.yaml. Large + local,
# never committed; the committed artefacts are perturb.py, the expected sheets, and the pre-reg.
/evaluation/adversarial/frozen/

# T4(b) synthetic-KAT working bundle — local working material (handoff notes, planted-key
# spec draft, reference freeze). The BUILT artefacts are committed under evaluation/synthetic/,
# evaluation/gold_specs/, docs/evaluation/; the paper PDF/tex live (gitignored) under /papers/synthetic/.
# This working bundle must never touch the remote.
/t4b-synthetic-kat/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Tool caches (type-checker / linter / test runner) — regenerable, machine-local.
# Present on disk; ignored explicitly so a fresh clone on any machine can never commit them
# (they were otherwise covered only by a per-user global excludesfile — not portable).
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Coverage artefacts (test-time only)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store


# Local workflow notes — not synced to remote
tasks/

# API keys for live Librarian extraction — NEVER commit (see .env.example)
.env
runs/

# one-shot holdout rehearsal run artefacts (local; the gated real-run marker oneshot_marker.jsonl is committed at the real run)
results/scientist/oneshot_rehearsal_quarantine/
agents/scientist/experimentalist/oneshot_holdout/markers/oneshot_rehearsal_marker.jsonl
